.intro {
    background: #f2f7ff;
    border-color: #dce7fb;
}

.intro-title {
    display: block;
    color: #23395f;
    font-size: 32rpx;
    font-weight: 600;
}

.intro-desc {
    display: block;
    margin-top: 12rpx;
    color: #5c6b84;
    font-size: 25rpx;
    line-height: 1.65;
}

.field-label {
    display: block;
    color: #1f2329;
    font-size: 27rpx;
    font-weight: 600;
}

.field-desc {
    display: block;
    margin-top: 10rpx;
    color: #9aa8bf;
    font-size: 22rpx;
    line-height: 1.6;
}

.seg {
    display: flex;
    margin-top: 16rpx;
}

.seg-item {
    flex: 1;
    padding: 16rpx 8rpx;
    border: 2rpx solid #dce7fb;
    border-radius: 12rpx;
    background: #ffffff;
    color: #6b7890;
    font-size: 24rpx;
    text-align: center;
}

.seg-item.on {
    border-color: #2f6fed;
    background: #eaf2ff;
    color: #2f6fed;
    font-weight: 600;
}

.seg-item + .seg-item {
    margin-left: 12rpx;
}

.btn-row {
    display: flex;
    margin-top: 18rpx;
}

.act {
    flex: 1;
    height: 72rpx;
    line-height: 72rpx;
    border: 2rpx solid #dce7fb;
    border-radius: 12rpx;
    background: #ffffff;
    color: #3d5375;
    font-size: 25rpx;
    text-align: center;
}

.act.primary {
    border-color: #2f6fed;
    background: #2f6fed;
    color: #ffffff;
    font-weight: 600;
}

.act + .act {
    margin-left: 12rpx;
}

.status {
    display: block;
    margin-top: 14rpx;
    color: #5c6b84;
    font-size: 23rpx;
    line-height: 1.6;
}

.result {
    margin-top: 20rpx;
    padding: 20rpx;
    border: 2rpx solid #dce7fb;
    border-radius: 14rpx;
    background: #f7faff;
}

.result-line {
    display: block;
    color: #23395f;
    font-size: 24rpx;
    line-height: 1.6;
}

.paste {
    box-sizing: border-box;
    margin-top: 14rpx;
    padding: 16rpx;
    width: 100%;
    min-height: 160rpx;
    border: 2rpx solid #dce7fb;
    border-radius: 12rpx;
    background: #ffffff;
    color: #1f2329;
    font-size: 24rpx;
    line-height: 1.6;
}

.confirm-box {
    margin-top: 20rpx;
    padding: 20rpx;
    border: 2rpx solid #f0d2b6;
    border-radius: 14rpx;
    background: #fff7ee;
}

.confirm-title {
    display: block;
    color: #9a6118;
    font-size: 25rpx;
    line-height: 1.6;
}

.desktop-card {
    background: #f4fbf6;
    border-color: #d7ecd9;
}

.footer-note {
    margin-top: 32rpx;
    color: #a6b0c0;
    font-size: 22rpx;
    text-align: center;
}
