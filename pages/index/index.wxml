<view class="page">
    <view class="hero">
        <view class="hero-head">
            <view class="hero-text">
                <text class="hero-title">我的身体单据</text>
                <text class="hero-sub">拍照归档 · 按拍照日期检索</text>
            </view>
            <view class="stat-badge">
                <text class="stat-num">{{totalCount}}</text>
                <text class="stat-label">条记录</text>
            </view>
        </view>
        <view class="local-notice">
            <text class="local-notice-text">数据仅保存在本机，换手机或卸载小程序会丢失</text>
        </view>
    </view>

    <view class="search-bar">
        <input class="search-input" placeholder="搜索关键字 / 类型 / 备注" value="{{keyword}}" bindinput="onKeywordInput" confirm-type="search" maxlength="40" />
        <view class="clear-btn" wx:if="{{keyword}}" bindtap="onClearKeyword">
            <text>清空</text>
        </view>
        <picker class="type-picker" mode="selector" range="{{typeNames}}" value="{{typeIndex}}" bindchange="onTypeChange">
            <view class="type-picker-inner">
                <text>{{activeTypeLabel}}</text>
                <text class="caret">▾</text>
            </view>
        </picker>
    </view>

    <view class="filter-card">
        <view class="filter-head">
            <text class="filter-title">拍照日期</text>
            <text class="filter-reset" wx:if="{{hasFilters}}" bindtap="onClearAll">重置全部筛选</text>
        </view>
        <view class="filter-row">
            <view class="grain-chip {{dateGranularity === item.key ? 'grain-chip-active' : ''}}" wx:for="{{dateGranularities}}" wx:key="key" wx:for-item="item" data-key="{{item.key}}" bindtap="onDateGranularityTap">
                <text>{{item.label}}</text>
            </view>
            <picker class="date-picker" mode="date" fields="{{dateFields}}" start="{{dateStart}}" end="{{dateEnd}}" value="{{datePickerValue}}" bindchange="onDateChange">
                <view class="date-picker-inner">
                    <text>{{dateBucket ? dateText : '选择日期'}}</text>
                    <text class="caret">▾</text>
                </view>
            </picker>
            <view class="date-clear" wx:if="{{dateBucket}}" bindtap="onClearDate">
                <text>清除</text>
            </view>
        </view>
        <scroll-view class="quick-bar" scroll-x="true" wx:if="{{quickDates.length}}">
            <view class="quick-chip {{dateBucket === item.bucket ? 'quick-chip-active' : ''}}" wx:for="{{quickDates}}" wx:key="bucket" wx:for-item="item" data-bucket="{{item.bucket}}" bindtap="onQuickDateTap">
                <text>{{item.label}} · {{item.count}} 条</text>
            </view>
        </scroll-view>
        <text class="filter-hint">可先选「按年 / 按月 / 按天」，再选具体日期；上方快捷项按记录条数排列。</text>
        <text class="filter-summary" wx:if="{{filterSummary}}">当前筛选：{{filterSummary}}</text>
    </view>

    <view class="chip-head">
        <text class="chip-label">高频检索标签 · 按出现次数排序</text>
        <text class="chip-mode" catchtap="onTagModeTap">{{tagMatchMode === 'all' ? '全部匹配' : '任一匹配'}} ⇄</text>
    </view>
    <scroll-view class="tag-bar" scroll-x="true">
        <view class="tag-chip {{activeTags.length === 0 ? 'tag-chip-active' : ''}}" catchtap="onClearTags">全部</view>
        <view class="tag-chip {{item.selected ? 'tag-chip-active' : ''}}" wx:for="{{tagChips}}" wx:key="key" wx:for-item="item" data-tag="{{item.tag}}" bindtap="onTagTap">
            <text>{{item.pinned ? '★ ' : ''}}{{item.label}}</text>
            <text class="tag-count">{{item.count}}</text>
            <text class="tag-x" wx:if="{{item.selected}}">×</text>
        </view>
        <view class="tag-chip tag-manage" catchtap="goTags">管理 ›</view>
    </scroll-view>

    <view class="state-card" wx:if="{{viewState === 'loading'}}">
        <text class="state-title">正在读取本机单据</text>
        <text class="state-desc">请稍候…</text>
    </view>

    <view class="state-card" wx:elif="{{viewState === 'error'}}">
        <text class="state-icon">!</text>
        <text class="state-title">读取失败</text>
        <text class="state-desc">{{errorMessage}}</text>
        <button class="primary-btn retry-btn" bindtap="handleRetry">重新加载</button>
    </view>

    <view class="state-card" wx:elif="{{viewState === 'empty'}}">
        <text class="state-icon">▢</text>
        <text class="state-title">{{hasRecords ? '没有匹配的单据' : '还没有单据'}}</text>
        <text class="state-desc">{{hasRecords ? '换个关键词、标签或日期试试' : '点下面按钮，把要留存的资料拍下来'}}</text>
        <button class="primary-btn retry-btn" bindtap="goUpload">去上传单据</button>
    </view>

    <block wx:else>
        <view class="date-group" wx:for="{{groups}}" wx:key="date" wx:for-item="group">
            <text class="group-label">{{group.label}}</text>
            <view class="bill-card" wx:for="{{group.items}}" wx:key="id" wx:for-item="item" data-id="{{item.id}}" bindtap="openDetail">
                <image class="bill-thumb" wx:if="{{item.thumb}}" src="{{item.thumb}}" mode="aspectFill" />
                <view class="bill-thumb bill-thumb-empty" wx:else>
                    <text>无图</text>
                </view>
                <view class="bill-main">
                    <view class="bill-row">
                        <text class="type-tag">{{item.docType}}</text>
                        <text class="bill-count">{{item.imageText}}</text>
                    </view>
                    <text class="bill-hospital">{{item.keywordText}}</text>
                    <text class="bill-note" wx:if="{{item.hasNote}}">{{item.noteText}}</text>
                    <text class="bill-time">存于 {{item.createdText}}</text>
                </view>
                <text class="bill-arrow">›</text>
            </view>
        </view>
    </block>

    <view class="ad-slot" wx:if="{{ad.enabled}}">
        <ad unit-id="{{ad.unitId}}" ad-type="banner" binderror="onAdError"></ad>
    </view>

    <view class="footer-note">
        <text>本工具仅用于单据整理与检索，不提供任何专业意见</text>
        <text style="display:block;margin-top:8rpx;color:#c2cad8;font-size:20rpx;">构建 B15 · 2026-11-06 10:29</text>
    </view>
</view>
